Subject: [PATCH] pylibfdt: support modern Python packaging

Use setuptools on current Python and remove the U-Boot tag prefix from
the Python extension version so packaging accepts it as a PEP 440 version.

Upstream-Status: Inappropriate [compatibility with the pinned vendor U-Boot]

diff --git a/scripts/dtc/pylibfdt/setup.py b/scripts/dtc/pylibfdt/setup.py
index 992cdec3..0264c91c 100755
--- a/scripts/dtc/pylibfdt/setup.py
+++ b/scripts/dtc/pylibfdt/setup.py
@@ -18,7 +18,10 @@ allows this script to be run stand-alone, e.g.:
     ./pylibfdt/setup.py install [--prefix=...]
 """

-from distutils.core import setup, Extension
+try:
+    from setuptools import setup, Extension
+except ImportError:
+    from distutils.core import setup, Extension
 import os
 import re
 import sys
@@ -97,6 +100,8 @@ files = os.environ.get('SOURCES', '').split()
 cflags = os.environ.get('CPPFLAGS', '').split()
 objdir = os.environ.get('OBJDIR')
 version = os.environ.get('VERSION')
+if version and version.startswith('u-boot-'):
+    version = version[len('u-boot-'):]
 swig_opts = os.environ.get('SWIG_OPTS', '').split()
 
 # If we were called directly rather than through our Makefile (which is often
