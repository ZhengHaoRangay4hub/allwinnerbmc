+namespace
+{
+constexpr const char* ch340SysfsTtyPath = "/sys/class/tty";
+constexpr const char* ch340VendorId = "1a86";
+constexpr std::array<const char*, 3> ch340ProductIds = {"5523", "7522",
+                                                        "7523"};
+
+std::string readSysfsValue(const fs::path& path)
+{
+    std::ifstream stream(path);
+    std::string value;
+
+    if (!std::getline(stream, value))
+    {
+        return {};
+    }
+
+    value.erase(std::remove_if(value.begin(), value.end(),
+                               [](unsigned char c) { return std::isspace(c); }),
+                value.end());
+    std::transform(value.begin(), value.end(), value.begin(),
+                   [](unsigned char c) { return std::tolower(c); });
+    return value;
+}
+
+bool isCh340UsbDevice(const fs::path& path)
+{
+    if (readSysfsValue(path / "idVendor") != ch340VendorId)
+    {
+        return false;
+    }
+
+    const std::string product = readSysfsValue(path / "idProduct");
+    return std::any_of(ch340ProductIds.begin(), ch340ProductIds.end(),
+                       [&product](const char* id) { return product == id; });
+}
+
+std::string findCh340Device()
+{
+    std::error_code error;
+    std::vector<std::string> matches;
+    fs::directory_iterator iterator(ch340SysfsTtyPath, error);
+    const fs::directory_iterator end;
+
+    while (!error && iterator != end)
+    {
+        const std::string ttyName = iterator->path().filename().string();
+        if (ttyName.rfind("ttyUSB", 0) == 0)
+        {
+            fs::path current = fs::canonical(iterator->path(), error);
+            while (!error && !current.empty())
+            {
+                if (isCh340UsbDevice(current))
+                {
+                    matches.emplace_back("/dev/" + ttyName);
+                    break;
+                }
+
+                const fs::path parent = current.parent_path();
+                if (parent == current)
+                {
+                    break;
+                }
+                current = parent;
+            }
+            error.clear();
+        }
+        iterator.increment(error);
+    }
+
+    std::sort(matches.begin(), matches.end());
+    return matches.empty() ? std::string{} : matches.front();
+}
