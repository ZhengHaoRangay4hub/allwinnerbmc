+bool Input::openMcu()
+{
+    termios settings{};
+    const std::string device = (mcuPath == "auto") ? findCh340Device()
+                                                    : mcuPath;
+
+    if (device.empty())
+    {
+        return false;
+    }
+
+    mcuFd = open(device.c_str(), O_RDWR | O_NOCTTY | O_CLOEXEC | O_NONBLOCK);
+    if (mcuFd < 0)
+    {
+        lg2::error("Failed to open HID MCU device {PATH} {ERROR}", "PATH",
+                   device, "ERROR", strerror(errno));
+        return false;
+    }
+
+    if (tcgetattr(mcuFd, &settings) < 0)
+    {
+        lg2::error("Failed to read HID MCU serial settings {ERROR}", "ERROR",
+                   strerror(errno));
+        close(mcuFd);
+        mcuFd = -1;
+        return false;
+    }
+
+    cfmakeraw(&settings);
+    cfsetispeed(&settings, B921600);
+    cfsetospeed(&settings, B921600);
+    settings.c_cflag |= CLOCAL | CREAD;
+#ifdef CRTSCTS
+    settings.c_cflag &= ~CRTSCTS;
+#endif
+
+    if (tcsetattr(mcuFd, TCSANOW, &settings) < 0)
+    {
+        lg2::error("Failed to configure HID MCU serial device {ERROR}",
+                   "ERROR", strerror(errno));
+        close(mcuFd);
+        mcuFd = -1;
+        return false;
+    }
+
+    tcflush(mcuFd, TCIOFLUSH);
+    lg2::info("Connected CH32V307 HID bridge through {PATH}", "PATH", device);
+    return true;
+}
+
+uint16_t Input::crc16(const uint8_t* data, size_t length)
+{
+    uint16_t crc = 0xFFFF;
+
+    for (size_t i = 0; i < length; ++i)
+    {
+        crc ^= static_cast<uint16_t>(data[i]) << 8;
+        for (int bit = 0; bit < 8; ++bit)
+        {
+            crc = (crc & 0x8000) ? static_cast<uint16_t>((crc << 1) ^ 0x1021)
+                                 : static_cast<uint16_t>(crc << 1);
+        }
+    }
+    return crc;
+}
+
+bool Input::writeMcuPacket(uint8_t type, const uint8_t* payload, size_t length)
+{
+    constexpr size_t headerLength = 6;
+    constexpr size_t crcLength = 2;
+    std::array<uint8_t, headerLength + KEY_REPORT_LENGTH + crcLength> frame{};
+    size_t frameLength;
+    size_t offset = 0;
+    int retries = MCU_WRITE_RETRY_MAX;
+    uint16_t checksum;
+    std::unique_lock<std::mutex> lock(mcuMutex);
+
+    if (mcuFd < 0 || length > KEY_REPORT_LENGTH)
+    {
+        return false;
+    }
+
+    frame[0] = mcuMagic0;
+    frame[1] = mcuMagic1;
+    frame[2] = mcuProtocolVersion;
+    frame[3] = type;
+    frame[4] = mcuSequence++;
+    frame[5] = static_cast<uint8_t>(length);
+    if (length != 0)
+    {
+        memcpy(&frame[headerLength], payload, length);
+    }
+    checksum = crc16(&frame[2], 4 + length);
+    frame[headerLength + length] = static_cast<uint8_t>(checksum);
+    frame[headerLength + length + 1] = static_cast<uint8_t>(checksum >> 8);
+    frameLength = headerLength + length + crcLength;
+
+    while (offset < frameLength)
+    {
+        ssize_t written = write(mcuFd, frame.data() + offset,
+                                frameLength - offset);
+        if (written > 0)
+        {
+            offset += static_cast<size_t>(written);
+            continue;
+        }
+        if (written < 0 && errno == EINTR)
+        {
+            continue;
+        }
+        if (written < 0 && (errno == EAGAIN || errno == EWOULDBLOCK))
+        {
+            if (retries-- == 0)
+            {
+                lg2::error("Timed out writing HID MCU packet");
+                close(mcuFd);
+                mcuFd = -1;
+                return false;
+            }
+            std::this_thread::sleep_for(std::chrono::milliseconds(2));
+            continue;
+        }
+
+        lg2::error("Failed to write HID MCU packet {ERROR}", "ERROR",
+                   strerror(errno));
+        close(mcuFd);
+        mcuFd = -1;
+        return false;
+    }
+    return true;
+}
+
+void Input::tick()
+{
+    auto now = std::chrono::steady_clock::now();
+
+    if (!mcuActive)
+    {
+        return;
+    }
+
+    if (mcuFd < 0 && now - lastMcuOpenAttempt >= mcuReconnectInterval)
+    {
+        lastMcuOpenAttempt = now;
+        if (openMcu())
+        {
+            writeMcuPacket(mcuReleaseAllPacket, nullptr, 0);
+            lastMcuHeartbeat = now;
+        }
+    }
+
+    if (mcuFd >= 0 && now - lastMcuHeartbeat >= mcuHeartbeatInterval)
+    {
+        lastMcuHeartbeat = now;
+        writeMcuPacket(mcuHeartbeatPacket, nullptr, 0);
+    }
+}
+
 } // namespace ikvm
