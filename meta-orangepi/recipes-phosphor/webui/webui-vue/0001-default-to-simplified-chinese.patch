From 1111111111111111111111111111111111111111 Mon Sep 17 00:00:00 2001
From: Orange Pi OpenBMC <openbmc@orangepi.local>
Date: Sat, 29 Aug 2026 18:40:00 +0800
Subject: [PATCH] Default to Simplified Chinese

Keep the runtime language picker and English fallback while selecting
Simplified Chinese for new browsers.

---
 src/i18n.js                   | 4 +++-
 src/store/modules/GlobalStore.js | 2 +-
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/src/i18n.js b/src/i18n.js
index 1111111..2222222 100644
--- a/src/i18n.js
+++ b/src/i18n.js
@@ -60,6 +60,7 @@ export function createI18nInstance(
   addAlias('en', 'en-US');
   addAlias('ru', 'ru-RU');
   addAlias('ka', 'ka-GE');
+  addAlias('zh', 'zh-CN');
 
   const normalize = (val) => {
     if (!val) return undefined;
@@ -67,5 +68,6 @@ export function createI18nInstance(
     if (s === 'en') return 'en-US';
     if (s === 'ru') return 'ru-RU';
     if (s === 'ka') return 'ka-GE';
+    if (s === 'zh') return 'zh-CN';
     return s;
   };
@@ -150,5 +152,5 @@ export function getRoutePageTitle(route, t, te, fallback = '') {
 
 const envName = import.meta.env.VITE_ENV_NAME;
 // Get default locale from local storage
-const stored = window.localStorage.getItem('storedLanguage');
+const stored = window.localStorage.getItem('storedLanguage') || 'zh-CN';
 export default createI18nInstance(envName, stored);
diff --git a/src/store/modules/GlobalStore.js b/src/store/modules/GlobalStore.js
index 3333333..4444444 100644
--- a/src/store/modules/GlobalStore.js
+++ b/src/store/modules/GlobalStore.js
@@ -47,7 +47,7 @@ const GlobalStore = {
     modelType: null,
     serialNumber: null,
     serverStatus: 'unreachable',
-    languagePreference: localStorage.getItem('storedLanguage') || 'en-US',
+    languagePreference: localStorage.getItem('storedLanguage') || 'zh-CN',
     isUtcDisplay: localStorage.getItem('storedUtcDisplay')
       ? JSON.parse(localStorage.getItem('storedUtcDisplay'))
       : true,
-- 
